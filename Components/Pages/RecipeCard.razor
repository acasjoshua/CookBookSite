<div class="card h-100 recipe-card">
    <div class="card-img-wrapper">
        <img src="@Recipe.ImageUrl" class="card-img-top" alt="@Recipe.Name" loading="lazy" />
        <span class="card-category-badge">@Recipe.Category</span>
    </div>
    <div class="card-body">
        <h5 class="card-title">@Recipe.Name</h5>
        <p class="card-text">@Recipe.Description</p>
        <div class="card-tags">
            @foreach (var tag in Recipe.Tags.Take(3))
            {
                <span class="card-tag">#@tag</span>
            }
        </div>
    </div>
    <div class="card-footer">
        <div class="card-meta">
            <span class="meta-item">⏱ @Recipe.TotalMinutes min</span>
            <span class="meta-dot">·</span>
            <span class="meta-item">🍽 @Recipe.Servings serves</span>
        </div>
        <a class="btn-view-recipe" href="recipe/@Recipe.Id">View Recipe</a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Recipe Recipe { get; set; } = default!;
}
